# Supabase Configuration
# Masukkan API keys Anda di bawah ini untuk menghubungkan real OAuth (Google, Facebook, Discord, Twitter/X)
# Silakan salin berkas ini menjadi .env

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Drive Auto-upload Configuration
# Dapatkan URL ini setelah mendeploy skrip google-apps-script.js sebagai Web App di Google Apps Script.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzPxvlI93bgmD_myp8KpocyMr4OX5wE6jsBRVbYLoW__rLik9AfukTQ2o0aU1SPF-CVDw/exec
